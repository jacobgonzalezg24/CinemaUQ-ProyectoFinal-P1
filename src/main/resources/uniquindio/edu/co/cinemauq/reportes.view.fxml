<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: transparent; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.cinemauq.controller.ReportesController">

    <VBox spacing="4">
        <Label styleClass="section-title" style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" text="Módulo de Reportes" />
        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" text="Consulta de ventas por empleado, recaudos globales e historial de transacciones" />
    </VBox>

    <!-- TARJETAS DE MÉTRICAS GENERALES -->
    <HBox spacing="20">
        <VBox spacing="6" style="-fx-background-color: rgba(255, 255, 255, 0.03); -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Total Entradas Vendidas" />
            <Label fx:id="lblTotalEntradas" style="-fx-text-fill: #7c3aed; -fx-font-size: 24px; -fx-font-weight: bold;" text="0" />
        </VBox>

        <VBox spacing="6" style="-fx-background-color: rgba(255, 255, 255, 0.03); -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Ingresos Totales Recaudados" />
            <Label fx:id="lblTotalIngresos" style="-fx-text-fill: #10b981; -fx-font-size: 24px; -fx-font-weight: bold;" text="0.00" />
        </VBox>

        <VBox spacing="6" style="-fx-background-color: rgba(255, 255, 255, 0.03); -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" text="Película Más Vendida" />
            <Label fx:id="lblPeliculaMasVendida" style="-fx-text-fill: #3b82f6; -fx-font-size: 18px; -fx-font-weight: bold;" text="-" wrapText="true" />
        </VBox>
    </HBox>

    <!-- SECCIÓN FILTRADO Y TABLA DE VENTAS POR EMPLEADO -->
    <VBox spacing="16" style="-fx-background-color: rgba(255, 255, 255, 0.02); -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: rgba(255, 255, 255, 0.06); -fx-border-radius: 16;" VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Consultar Ventas por Empleado:" />
            <ComboBox fx:id="cmbEmpleadoFiltro" prefWidth="250" promptText="Seleccione un empleado..." style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;" />
            <Button onAction="#handleMostrarTodas" style="-fx-background-color: rgba(124, 58, 237, 0.3); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 14; -fx-background-radius: 8;" text="Mostrar Todas las Ventas" />
        </HBox>

        <TableView fx:id="tblVentas" styleClass="dark-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigoVenta" prefWidth="90" text="Cód Venta" />
                <TableColumn fx:id="colEmpleado" prefWidth="180" text="Empleado (Vendedor)" />
                <TableColumn fx:id="colCliente" prefWidth="180" text="Cliente" />
                <TableColumn fx:id="colPelicula" prefWidth="200" text="Película" />
                <TableColumn fx:id="colAsiento" prefWidth="80" text="Asiento" />
                <TableColumn fx:id="colValor" prefWidth="120" text="Valor Pagado" />
            </columns>
        </TableView>

    </VBox>
</VBox>