<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="25" style="-fx-background-color: transparent; -fx-padding: 30;" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.cinemauq.controller.PeliculasController">

    <!-- TABLA DE PELÍCULAS (Lado Izquierdo - Panel Oscuro Glassmorphic) -->
    <VBox HBox.hgrow="ALWAYS" spacing="15" style="-fx-background-color: rgba(255, 255, 255, 0.02); -fx-background-radius: 16; -fx-padding: 24; -fx-border-color: rgba(255, 255, 255, 0.06); -fx-border-radius: 16;">
        <Label text="Gestión de Películas" style="-fx-font-size: 22px; -fx-text-fill: white; -fx-font-weight: bold;" />

        <TableView fx:id="tablePeliculas" VBox.vgrow="ALWAYS" styleClass="dark-table">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="90" />
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200" />
                <TableColumn fx:id="colGenero" text="Género" prefWidth="130" />
                <TableColumn fx:id="colDuracion" text="Duración (min)" prefWidth="120" />
                <TableColumn fx:id="colClasificacion" text="Clasificación" prefWidth="130" />
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="120" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- FORMULARIO DE GESTIÓN (Lado Derecho - Tarjeta Glassmorphic) -->
    <VBox spacing="14" prefWidth="340" style="-fx-background-color: rgba(255, 255, 255, 0.03); -fx-background-radius: 16; -fx-padding: 24; -fx-border-color: rgba(255, 255, 255, 0.08); -fx-border-radius: 16;">
        <Label text="Detalles de Película" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />

        <VBox spacing="4">
            <Label text="Código" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <TextField fx:id="txtCodigo" promptText="Ej: 101" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8;" />
        </VBox>

        <VBox spacing="4">
            <Label text="Nombre" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <TextField fx:id="txtNombre" promptText="Título de la película" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8;" />
        </VBox>

        <VBox spacing="4">
            <Label text="Género" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <TextField fx:id="txtGenero" promptText="Ej: Acción, Sci-Fi" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8;" />
        </VBox>

        <VBox spacing="4">
            <Label text="Duración (minutos)" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <TextField fx:id="txtDuracion" promptText="Ej: 120" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8;" />
        </VBox>

        <VBox spacing="4">
            <Label text="Clasificación" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <ComboBox fx:id="cmbClasificacion" promptText="Seleccionar..." maxWidth="Infinity" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;" />
        </VBox>

        <VBox spacing="4">
            <Label text="Estado" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <ComboBox fx:id="cmbEstado" promptText="Seleccionar..." maxWidth="Infinity" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;" />
        </VBox>

        <VBox spacing="4">
            <Label text="Imagen / Póster" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" />
            <HBox spacing="8">
                <TextField fx:id="txtImagen" promptText="Nombre o archivo de imagen" HBox.hgrow="ALWAYS" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-padding: 8;" />
                <Button text="📁" onAction="#onSeleccionarImagen" style="-fx-background-color: rgba(139, 92, 246, 0.3); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 12; -fx-background-radius: 8;" />
            </HBox>
        </VBox>

        <!-- Botonera de acciones fija en la parte inferior de la tarjeta -->
        <VBox spacing="8" style="-fx-padding: 15 0 0 0;">
            <Button text="Registrar / Guardar" onAction="#onRegistrarPelicula" maxWidth="Infinity" style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10; -fx-background-radius: 8;" />
            <HBox spacing="10">
                <Button text="Eliminar" onAction="#onEliminarPelicula" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: rgba(239, 68, 68, 0.15); -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 8;" />
                <Button text="Limpiar" onAction="#onLimpiarFormulario" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: rgba(255, 255, 255, 0.05); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8; -fx-background-radius: 8;" />
            </HBox>
        </VBox>
    </VBox>

</HBox>