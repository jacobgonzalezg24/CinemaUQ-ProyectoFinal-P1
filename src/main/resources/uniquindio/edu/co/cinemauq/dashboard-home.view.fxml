<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="transparent-scroll" stylesheets="@dashboard.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniquindio.edu.co.cinemauq.controller.DashboardHomeController">
    <content>
        <VBox spacing="30.0" style="-fx-background-color: transparent;">
            <padding>
                <Insets bottom="60.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>

                <StackPane fx:id="heroContainer" alignment="CENTER_LEFT" prefHeight="380.0" styleClass="hero-card">
                    <children>

                        <!-- IMAGEN DE FONDO CON FX:ID -->
                        <StackPane alignment="CENTER_RIGHT">
                            <children>
                                <ImageView fx:id="heroImageView" fitHeight="380.0" preserveRatio="true" pickOnBounds="true">
                                    <image>
                                        <Image url="@images/spiderman-banner.jpg" />
                                    </image>
                                </ImageView>
                            </children>
                        </StackPane>

                        <!-- CONTENIDO SUPERPUESTO -->
                        <VBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 50px;">
                            <children>
                                <Label style="-fx-text-fill: #a78bfa; -fx-font-size: 14px; -fx-font-weight: bold; -fx-letter-spacing: 1px;" text="ESTRENO DESTACADO" />
                                <Label style="-fx-text-fill: #ffffff; -fx-font-size: 36px; -fx-font-weight: bold;" text="EL SORPRENDENTE HOMBRE ARAÑA" />
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 16px;" text="Disfruta de la mejor cartelera y las salas IMAX exclusivas de CinemaUQ." />

                                <HBox spacing="15.0" style="-fx-padding: 15 0 0 0;">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#handleComprarEntradas" styleClass="action-button" text="Comprar Entradas" />
                                        <Button mnemonicParsing="false" onAction="#handleVerTrailer" styleClass="nav-button" style="-fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 8px;" text="Ver Tráiler" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </StackPane>

                <!-- SECCIÓN: EN CARTELERA -->
                <VBox spacing="20.0">
                    <children>
                        <Label styleClass="section-title" text="PELÍCULAS EN CARTELERA" />

                        <ScrollPane fitToHeight="true" hbarPolicy="ALWAYS" vbarPolicy="NEVER" styleClass="horizontal-scroll-pane" prefHeight="860.0">
                            <content>
                                <HBox fx:id="containerCartelera" spacing="35.0" style="-fx-padding: 10px 15px 25px 5px;" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>